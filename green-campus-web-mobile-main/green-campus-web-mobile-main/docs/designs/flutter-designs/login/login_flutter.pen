                  "content": "Scaffold(\n  body: SafeArea(\n    child: SingleChildScrollView(\n      child: Padding(\n        padding: EdgeInsets.symmetric(h: 24),\n        child: Form(\n          key: _formKey,\n          child: Column([\n            EmailTextField(\n              focusNode: _emailFocus,\n              onFieldSubmitted: → _pwdFocus,\n              validator: ..., // domain/\n              autovalidateMode: onUserInteraction,\n            ),\n            PasswordTextField(\n              focusNode: _passwordFocus,\n              onFieldSubmitted: → _submit,\n              validator: ..., // domain/\n              autovalidateMode: onUserInteraction,\n            ),\n            ForgotPasswordLink(onTap: ...),\n            PrimaryButton(\n              onPressed: _submit,\n              isLoading: state.isSubmitting,\n            ),\n          ])\n        )\n      )\n    )\n  )\n)\n// on submit → FocusScope.unfocus()\n// Listener → SnackBar(state.globalError)",
