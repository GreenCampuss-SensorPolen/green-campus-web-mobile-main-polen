                              "iconFontFamily": "lucide",
                              "fill": "$--accent-green"
                            },
                            {
                              "type": "text",
                              "id": "HLpto",
                              "name": "emailPlaceholder",
                              "fill": "$--text-tertiary",
                              "content": "usuario@greencampus.edu",
                              "fontFamily": "Inter",
                              "fontSize": 14,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "AhKIk",
