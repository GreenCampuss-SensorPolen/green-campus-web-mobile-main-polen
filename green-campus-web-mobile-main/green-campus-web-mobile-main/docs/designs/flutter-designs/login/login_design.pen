                            {
                              "type": "text",
                              "id": "B1Adu",
                              "name": "pwdPlaceholder",
                              "fill": "$--text-tertiary",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "••••••••",
                              "fontFamily": "Inter",
                              "fontSize": 18,
                              "fontWeight": "normal"
