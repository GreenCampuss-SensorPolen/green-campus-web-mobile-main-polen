{
  "version": "2.8",
  "children": [
    {
      "type": "frame",
      "id": "1X1ZZ",
      "x": 0,
      "y": 0,
      "name": "Login Screen",
      "width": 360,
      "height": 740,
      "fill": "$--bg-page",
      "layout": "vertical",
      "children": [
        {
          "type": "frame",
          "id": "nYPux",
          "name": "SafeArea",
          "width": "fill_container",
          "height": "fill_container",
          "layout": "vertical",
          "children": [
            {
              "type": "frame",
              "id": "J0a0q",
              "name": "SingleChildScrollView",
              "width": "fill_container",
              "height": "fill_container",
              "layout": "vertical",
              "padding": [
                60,
                24,
                40,
                24
              ],
              "children": [
                {
                  "type": "frame",
                  "id": "CEiN4",
                  "name": "LogoSection",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 12,
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "frame",
                      "id": "pfRej",
                      "name": "LogoContainer",
                      "width": 72,
                      "height": 72,
                      "fill": "$--accent-green",
                      "cornerRadius": 36,
                      "layout": "vertical",
                      "justifyContent": "center",
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "icon_font",
                          "id": "ixA5j",
                          "name": "logoIcon",
                          "width": 36,
                          "height": 36,
                          "iconFontName": "leaf",
                          "iconFontFamily": "lucide",
                          "fill": "$--white"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "b0JZM",
                      "name": "LogoTitle",
                      "fill": "$--text-primary",
                      "content": "Green Campus",
                      "fontFamily": "Plus Jakarta Sans",
                      "fontSize": 24,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "hxU4D",
                      "name": "LogoSubtitle",
                      "fill": "$--text-secondary",
                      "content": "Inicia sesión en tu cuenta",
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "mjrqc",
                  "name": "Spacer",
                  "width": "fill_container",
                  "height": 40
                },
                {
                  "type": "frame",
                  "id": "oC9XS",
                  "name": "Form",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 20,
                  "children": [
                    {
                      "type": "frame",
                      "id": "BDf6P",
                      "name": "email_input",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 6,
                      "children": [
                        {
                          "type": "text",
                          "id": "vPdaa",
                          "name": "emailLabel",
                          "fill": "$--text-primary",
                          "content": "Correo electrónico",
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "600"
                        },
                        {
                          "type": "frame",
                          "id": "9q9QV",
                          "name": "emailInputFrame",
                          "width": "fill_container",
                          "height": 48,
                          "fill": "$--white",
                          "cornerRadius": "$--radius-input",
                          "stroke": {
                            "align": "inside",
                            "thickness": 1.5,
                            "fill": "$--border-standard"
                          },
                          "gap": 10,
                          "padding": [
                            0,
                            14
                          ],
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "icon_font",
                              "id": "ZMT9R",
                              "name": "emailIcon",
                              "width": 20,
